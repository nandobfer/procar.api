name: procar.api

services:
  api:
    image: nandoburgos/procar.api
    container_name: procar.api
    environment:
      - PORT=4002
      - DATABASE_URL=mysql://user:pass@mysql-server:3306/procar?connection_limit=20&socketTimeout=30
      - URL=https://api-procar.nandoburgos.dev
      - WEBSITE_URL=https://procar.nandoburgos.dev
      - JWT_SECRET=0IGSGJ0IWOsdljfo
      - SMTP_USER=get_from_github_secrets
      - SMTP_PASS=get_from_github_secrets
    ports:
      - "4002:4002"
    restart: unless-stopped
    networks:
      - mysql-network
    volumes:
      - static_volume:/app/static
    deploy:
      resources:
        limits:
          cpus: '0.25'
          memory: 256M

volumes:
  static_volume:
    name: "procar_static_files"

networks:
  mysql-network:
    external: true
